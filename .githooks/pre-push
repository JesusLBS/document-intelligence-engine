#!/bin/sh
# Blocks direct pushes to protected branches (main, develop).
# Activate once per clone: git config core.hooksPath .githooks
# Local safety net only; GitHub branch protection is the real enforcement.

protected="main develop"

while read -r local_ref local_sha remote_ref remote_sha; do
  branch=$(echo "$remote_ref" | sed 's#refs/heads/##')

  for p in $protected; do
    if [ "$branch" = "$p" ]; then
      echo ""
      echo "Push bloqueado: '$branch' es una rama protegida (main/develop) — nunca se pushea directo aqui."
      echo "Crea una rama desde develop y abre un PR:"
      echo "  git switch develop && git pull"
      echo "  git switch -c feature/<nombre>"
      echo ""
      exit 1
    fi
  done
done

exit 0
