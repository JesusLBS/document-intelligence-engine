APP_NAME=Document Intelligence Engine
APP_ENV=local
APP_DEBUG=true
TZ=America/Mexico_City
MAX_FILE_SIZE_MB=10
UPLOAD_FOLDER=uploads
DEFAULT_EXTRACTOR=regex
DEFAULT_LANGUAGE=es
LOG_LEVEL=DEBUG
LOG_CHANNEL=stack

# AI Provider (gemini, groq)
AI_PROVIDER=gemini

# Gemini (current stable models: https://ai.google.dev/gemini-api/docs/models)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
# Gemini 3: low | medium | high. Leave empty for models without thinkingLevel (e.g. 2.5)
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_SECONDS=90

# Groq (current models: https://console.groq.com/docs/models)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# Reasoning models (gpt-oss): low | medium | high. Leave empty for non-reasoning models
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_SECONDS=60